{
    "compilerOptions": {
        "target": "ES2021",
        "lib": ["ES2021"],
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "types": ["@cloudflare/workers-types", "vitest/globals"],
        "strict": true,
        "noImplicitAny": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true
    },
    "include": ["src", "test"]
}
