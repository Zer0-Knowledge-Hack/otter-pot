# Copiar a `.dev.vars` y completar. Ese archivo esta gitignoreado: nunca se commitea.
# En produccion estos valores van con `wrangler secret put`, no en un archivo.

# ── Telegram ──────────────────────────────────────────────────────────────────
# Token que da @BotFather con /newbot.
TELEGRAM_BOT_TOKEN=

# Secreto del webhook: Telegram lo manda en el header X-Telegram-Bot-Api-Secret-Token
# y el worker rechaza todo lo que no coincida. Generar uno al azar:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=

ENVIRONMENT=development

# ── Cadena ────────────────────────────────────────────────────────────────────
# Arbitrum Sepolia. CHAIN_ID y CHAIN_RPC_URL tienen que ser de la misma red: si no
# coinciden, el nodo rechaza la firma con «invalid chain id for signer».
# En produccion CHAIN_RPC_URL va con `wrangler secret put` (puede llevar API key).
#
# Otra cadena soportada: Nitro local → CHAIN_ID=412346  CHAIN_RPC_URL=http://127.0.0.1:8547
CHAIN_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
CHAIN_ID=421614

# ChallengePool desplegado en la cadena de arriba (reemplazar el placeholder).
CHALLENGE_POOL_ADDRESS=0x<pool-address>

# Token USDC de esa cadena (reemplazar el placeholder). Los montos se escalan
# leyendo los decimales del propio token.
USDC_ADDRESS=0x<usdc-address>

# Cuenta operadora: wallet de testnet dedicada y descartable, NUNCA una con fondos
# reales. Tiene que estar registrada con addOperator() por el owner del pool, o
# /confirmar va a fallar al resolver. Necesita ETH de Arbitrum Sepolia para pagar el gas.
OPERATOR_PRIVATE_KEY=

# ── Mini App ──────────────────────────────────────────────────────────────────
# URL publica de la pagina de deposito. En desarrollo sale de:
#   cloudflared tunnel --url http://127.0.0.1:3000
# Es efimera: si cloudflared se reinicia, cambia y hay que actualizarla.
MINIAPP_URL=
