# Copiar a `.env.local` y completar. Ese archivo esta gitignoreado.
# Todo lo que empieza con NEXT_PUBLIC_ queda expuesto en el navegador:
# nunca poner secretos aca.

# Contratos en Arbitrum Sepolia (SDD v6 §5.3.1).
NEXT_PUBLIC_CHALLENGE_POOL_ADDRESS=0xbc0ce54d80b3f95067285297f6ec052e79ecef46

# USDC de Circle, 6 decimales. La pagina lee decimals() del token, no los asume.
NEXT_PUBLIC_USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d

# RPC. El publico alcanza; con una API key propia de Alchemy vas mas comodo.
NEXT_PUBLIC_CHAIN_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
